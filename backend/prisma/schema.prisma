// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model RequestService {
  RequestServiceID Int  @id
  Description      String
  Order            Order[]
}

enum PropertyOccupancy {
  VACANT        @map("VACANT")
  OWNER         @map("OWNER")
  TENANT
}

model Customer {
  CustomerID   String  @id
  Title        String?
  FirstName    String
  MiddleName   String?
  LastName     String
  Suffix       String?
  PhoneNumber  String  @unique
  EmailAddress String?
  Brokerage    String?
  Orders       Order[]
}

model Order {
  OrderID              String            @id
  CreatedAt            DateTime          @default(now())
  PropertyAddress      String
  PropertyCounty       String?
  RequestedService     RequestService    @relation(fields: [RequestedServiceID], references: [RequestServiceID])
  RequestedServiceID   Int
  RequestedInstallDate DateTime
  RequestedRemoveDate  DateTime?
  Occupancy            PropertyOccupancy
  belongsTo            Customer          @relation(fields: [CustomerID], references: [CustomerID])
  CustomerID           String
  Fullfillment         Fullfillment?
  Removal              Removal?
  Attachments          Attachment[]
}

model Employee {
  EmployeeID   String         @id
  FirstName    String
  LastName     String
  PhoneNumber  String         @unique
  Fullfillment Fullfillment[]
  Removals     Removal[]
}

model Fullfillment {
  Order                 Order    @relation(fields: [FullfilledOrderID], references: [OrderID])
  FullfilledOrderID     String   @unique
  FullfilledAt          DateTime
  EmployeeWhoFullfilled Employee @relation(fields: [FullfilledEmployeeID], references: [EmployeeID])
  FullfilledEmployeeID  String
}

model Removal {
  Order              Order    @relation(fields: [RemovedOrderID], references: [OrderID])
  RemovedOrderID     String   @unique
  RemovedAt          DateTime
  EmployeeWhoRemoved Employee @relation(fields: [RemovedEmployeeID], references: [EmployeeID])
  RemovedEmployeeID  String
}

model Attachment {
  Order          Order  @relation(fields: [OrderID], references: [OrderID])
  OrderID        String @id
  AttachmentData Bytes
}
