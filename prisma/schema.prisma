// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model RequestService {
  RequestServiceID String  @id @default(uuid())
  Description      String
  Order            Order[]
}

enum PropertyOccupancy {
  Vacant        @map("VACANT")
  OwnerOccupied @map("OWNER")
  TENANT
}

model Customer {
  CustomerID   String  @id @default(uuid())
  FirstName    String
  LastName     String
  PhoneNumber  String  @unique
  EmailAddress String  @unique
  Orders       Order[]
}


model Order {
  OrderID              String            @id @default(uuid())
  CreatedAt            DateTime          @default(now())
  PropertyAddress      String
  PropertyCounty       String
  RequestedService     RequestService    @relation(fields: [RequestedServiceID], references: [RequestServiceID])
  RequestedServiceID   String
  RequestedServiceDate DateTime
  Occupancy            PropertyOccupancy
  belongsTo            Customer          @relation(fields: [CustomerID], references: [CustomerID])
  CustomerID           String
  Fullfillment         Fullfillment?
  Attachment           Attachment[]
}

model Employee {
  EmployeeID   String         @id @default(uuid())
  FirstName    String
  LastName     String
  Fullfillment Fullfillment[]
}

model Fullfillment {
  Order                 Order    @relation(fields: [FullfilledOrderID], references: [OrderID])
  FullfilledOrderID     String   @unique
  FullfilledAt          DateTime
  EmployeeWhoFullfilled Employee @relation(fields: [FullfilledEmployeeID], references: [EmployeeID])
  FullfilledEmployeeID  String
}

model Attachment {
  Order          Order  @relation(fields: [OrderID], references: [OrderID])
  OrderID        String @id
  AttachmentData Bytes
}
